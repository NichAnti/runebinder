{
  "name": "cardtrader",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "vite build",
    "preview": "vite preview",
    "catalogue:build": "bun scripts/catalogue/build.ts",
    "catalogue:pack": "tar -czf catalogue/recordings.tar.gz -C catalogue recordings",
    "catalogue:unpack": "tar -xzf catalogue/recordings.tar.gz -C catalogue",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "test": "vitest run",
    "lint": "oxlint src scripts && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src scripts",
    "check": "oxfmt --check && bun run lint && bun run typecheck && bun run test",
    "prepare": "test -z \"$CI\" && simple-git-hooks || true"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.83",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@effect/platform-browser": "4.0.0",
    "@effect/sql-d1": "4.0.0",
    "@foldkit/ui": "0.169.0",
    "@orama/orama": "3.1.18",
    "@piltoverarchive/riftbound-deck-codes": "1.5.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0",
    "foldkit": "0.169.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/tsgo": "0.50.0",
    "@effect/vitest": "4.0.0",
    "@foldkit/devtools": "0.169.0",
    "@foldkit/devtools-mcp": "0.25.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@foldkit/vite-plugin": "0.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "alchemy": "2.0.0-beta.83",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "pre-push": "bun run check"
  },
  "overrides": {
    "@effect/sql-d1": "4.0.0",
    "@effect/sql-sqlite-do": "4.0.0"
  }
}
